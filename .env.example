# Modelo de arquivo de ambiente do app. Valores EXPO_PUBLIC_* vão para
# dentro do bundle/APK — só coloque aqui valores públicos (nunca a
# service role do Supabase).
#
#   cp .env.example .env.dev    → DEV local (backend + Supabase locais)
#   cp .env.example .env.tcc    → TCC
#   cp .env.example .env.prod   → produção (builds de PROD: web e APK)
#
# Os scripts desligam o dotenv do Expo (EXPO_NO_DOTENV=1) e carregam o
# arquivo explicitamente — não crie `.env` nem `.env.local`.

# Valores abaixo = DEV local. No celular, troque localhost pelo IP da
# máquina na rede (ex.: http://192.168.0.10:3000).
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_API_KEY=

# desenvolvimento | tcc | homologacao | producao — fora de producao, o app
# exibe um aviso de ambiente no topo da tela.
EXPO_PUBLIC_APP_ENV=desenvolvimento
