{
  "name": "se-controle-rn",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "^2.109.0",
    "expo": "~56.0.24",
    "expo-constants": "~56.0.18",
    "expo-dev-client": "~56.0.28",
    "expo-file-system": "~56.0.11",
    "expo-font": "~56.0.7",
    "expo-linking": "~56.0.19",
    "expo-router": "~56.2.22",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.27",
    "expo-splash-screen": "~56.0.16",
    "expo-sqlite": "~56.0.6",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.7",
    "expo-web-browser": "~56.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.1.0",
    "jest": "~29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "cross-env EXPO_NO_DOTENV=1 dotenv -e .env.prod -- expo start --dev-client",
    "android": "cross-env EXPO_NO_DOTENV=1 dotenv -e .env.prod -- expo run:android",
    "ios": "cross-env EXPO_NO_DOTENV=1 dotenv -e .env.prod -- expo run:ios",
    "build:web": "cross-env EXPO_NO_DOTENV=1 dotenv -e .env.prod -- expo export -p web",
    "web": "cross-env EXPO_NO_DOTENV=1 dotenv -e .env.prod -- expo start --web",
    "eas:prod": "npx eas-cli@latest build --profile production",
    "eas:dev": "expo start --dev-client",
    "test": "jest",
    "web:hml": "cross-env EXPO_NO_DOTENV=1 dotenv -e .env.hml -- expo start --web",
    "start:hml": "cross-env EXPO_NO_DOTENV=1 dotenv -e .env.hml -- expo start",
    "android:hml": "cross-env EXPO_NO_DOTENV=1 dotenv -e .env.hml -- expo start --android",
    "ios:hml": "cross-env EXPO_NO_DOTENV=1 dotenv -e .env.hml -- expo start --ios",
    "web:prod": "cross-env EXPO_NO_DOTENV=1 dotenv -e .env.prod -- expo start --web",
    "start:prod": "cross-env EXPO_NO_DOTENV=1 dotenv -e .env.prod -- expo start",
    "android:prod": "cross-env EXPO_NO_DOTENV=1 dotenv -e .env.prod -- expo start --android",
    "ios:prod": "cross-env EXPO_NO_DOTENV=1 dotenv -e .env.prod -- expo start --ios"
  },
  "private": true
}
